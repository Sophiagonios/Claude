{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "color": {
      "palette": [
        { "slug": "paper", "name": "Papier", "color": "#FFFFFF" },
        { "slug": "navy", "name": "Marine", "color": "#123A5E" },
        { "slug": "navy-dark", "name": "Marine foncé", "color": "#0B2740" },
        { "slug": "accent", "name": "Accent bronze", "color": "#C98A33" },
        { "slug": "text", "name": "Texte", "color": "#16202B" },
        { "slug": "text-soft", "name": "Texte atténué", "color": "#48545F" }
      ]
    },
    "typography": {
      "fontFamilies": [
        { "slug": "display", "name": "Titres", "fontFamily": "'Archivo', system-ui, sans-serif" },
        { "slug": "body", "name": "Texte", "fontFamily": "'Public Sans', system-ui, sans-serif" },
        { "slug": "mono", "name": "Mono", "fontFamily": "'IBM Plex Mono', ui-monospace, monospace" }
      ]
    },
    "layout": { "contentSize": "760px", "wideSize": "1240px" }
  },
  "styles": {
    "color": { "background": "#FFFFFF", "text": "#16202B" },
    "typography": { "fontFamily": "'Public Sans', system-ui, sans-serif" },
    "elements": {
      "button": {
        "color": { "background": "#C98A33", "text": "#2B1B04" },
        "border": { "radius": "10px" }
      },
      "heading": {
        "typography": { "fontFamily": "'Archivo', system-ui, sans-serif", "fontWeight": "800" }
      }
    }
  }
}
